{
  "version": "1.0.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "npm run dev",
    "dev": "npm --prefix ui run dev",
    "dev:all": "concurrently -n ui,backend -c cyan,magenta \"npm --prefix ui run dev\" \"npm --prefix backend run dev\"",
    "build": "npm --prefix ui install --include=optional --no-package-lock && npm --prefix ui run build",
    "build:ui": "npm --prefix ui run build",
    "lint": "npm --prefix ui run lint",
    "test": "npm run backend:test && npm run ui:test",
    "check": "npm run lint && npm run test && npm run build:ui",
    "preview": "npm --prefix ui run preview",
    "verify:prod": "node ./scripts/verify-production.mjs",
    "seed:superheroes": "npm --prefix ui run seed:superheroes --",
    "backend:dev": "npm --prefix backend run dev",
    "backend:start": "npm --prefix backend run start",
    "backend:test": "npm --prefix backend run test",
    "backend:test:coverage": "npm --prefix backend run test:coverage",
    "ui:test": "npm --prefix ui run test",
    "ui:test:watch": "npm --prefix ui run test:watch",
    "import:gcd": "npm --prefix backend run import:gcd",
    "import:gcd:issue": "npm --prefix backend run import:gcd:issue",
    "import:collected-edition": "npm --prefix backend run import:collected-edition",
    "link:collected-edition-issues": "npm --prefix backend run link:collected-edition-issues",
    "upload:collected-cover": "npm --prefix backend run upload:collected-cover --",
    "test-users:create": "npm --prefix backend run test-users:create --",
    "supabase:link": "npx supabase link",
    "supabase:start": "npx supabase start",
    "supabase:stop": "npx supabase stop",
    "supabase:status": "npx supabase status",
    "supabase:migration:new": "npx supabase migration new",
    "supabase:migrations:list": "npx supabase migration list",
    "supabase:push:dry": "npx supabase db push --dry-run",
    "supabase:push": "npx supabase db push"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "supabase": "^2.92.1"
  }
}
