  SUPERHEROES ||--o{ HERO_ISSUE_STAGES : agrupa
  SUPERHEROES ||--o{ HERO_ISSUES : desa_cache
  SUPERHEROES ||--o{ HERO_TIMELINES : publica
  SUPERHEROES ||--o{ COLLECTED_EDITIONS : cataloga

  HERO_ISSUE_STAGES o|--o{ HERO_TIMELINES : etiqueta
  HERO_ISSUES o|--o{ HERO_TIMELINES : numero_canonic
  HERO_ISSUES ||--o{ COLLECTED_EDITION_ISSUE_LINKS : numero_inclos
  COLLECTED_EDITIONS ||--o{ COLLECTED_EDITION_ISSUE_LINKS : conte

  HERO_TIMELINES ||--o{ USER_ISSUE_STATES : registra
  HERO_TIMELINES ||--o{ USER_ISSUE_COLLECTED_EDITIONS : registra
